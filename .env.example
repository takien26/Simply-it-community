# ==============================================================================
# SIMPLY IT — Community & Enterprise Edition
# Production Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/it_asset_db?schema=public"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Chuỗi khóa bí mật ký token JWT (tối thiểu 32 ký tự ngẫu nhiên, khuyến nghị 64+).
# LƯU Ý: Nếu bỏ trống hoặc chưa cấu hình, hệ thống sẽ TỰ ĐỘNG sinh khóa 512-bit
# ngẫu nhiên duy nhất và lưu bền vững vào file .certificates/.jwt_secret.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Khóa bí mật bảo vệ các tác vụ nền Cron (/api/cron/*).
CRON_SECRET="simply-internal-cron-production-secret-change-this"

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL SERVICE (Gửi thông báo Email Ticket, Quá hạn SLA, Reset Password)
# ------------------------------------------------------------------------------
# Cấu hình máy chủ gửi thư (Gmail, Microsoft 365, Amazon SES, SendGrid, SMTP nội bộ)
# Có thể cấu hình tại đây hoặc trong giao diện: Cài đặt -> Email & Thông báo
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="itsupport@company.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM_NAME="SIMPLY IT Helpdesk"
SMTP_FROM_EMAIL="itsupport@company.com"

# ------------------------------------------------------------------------------
# 4. SERVER PORTS & NETWORK DEPLOYMENT
# ------------------------------------------------------------------------------
PORT="3001"
HTTPS_PORT="3443"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI ASSISTANT (Tự động bóc tách hóa đơn, chat hỗ trợ, gợi ý xử lý)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
AI_PROVIDER="gemini"
AI_AUTO_SAVE_THRESHOLD="0.85"

# ------------------------------------------------------------------------------
# 6. FILE STORAGE & UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB="25"
UPLOAD_DIR="./public/uploads"
